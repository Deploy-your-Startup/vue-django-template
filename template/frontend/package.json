{
  "name": "startup-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.1",
    "bootstrap": "^5.3.8",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/bootstrap": "^5.2.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0",
    "flatted": "^3.4.2",
    "undici": "^7.24.5"
  }
}
