{
  "name": "startup-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "oxlint --deny-warnings && eslint .",
    "format": "prettier --write src/",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format:check": "prettier --check src/",
    "lint:architecture": "depcruise --config .dependency-cruiser.cjs src --output-type err-long",
    "test:architecture": "node --test tests/architecture.checks.mjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.4",
    "bootstrap": "^5.3.8",
    "vanilla-cookieconsent": "3.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/bootstrap": "^5.2.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0",
    "flatted": "^3.4.2",
    "undici": "^7.24.5"
  }
}
